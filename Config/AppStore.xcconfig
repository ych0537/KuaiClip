// Public, non-secret build settings for the Mac App Store target.
// Keep developer team IDs, signing identities, and product IDs in the ignored
// AppStore.local.xcconfig file.

PRODUCT_BUNDLE_IDENTIFIER = com.kuaiclip.clipboard.appstore
PRODUCT_NAME = KuaiClip
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) APP_STORE
CODE_SIGN_ENTITLEMENTS = Config/AppStore.entitlements
INFOPLIST_FILE = Config/AppStore-Info.plist
GENERATE_INFOPLIST_FILE = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
CODE_SIGN_STYLE = Automatic
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
GCC_GENERATE_DEBUGGING_SYMBOLS = YES

KUAICLIP_LIFETIME_PRODUCT_ID =

#include? "AppStore.local.xcconfig"
